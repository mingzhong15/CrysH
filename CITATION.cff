    given-names: Qiyu
    email: zengqiyu15@163.com
repository-code: "https://github.com/mingzhong15/CrysH"
license: MIT
type: software
keywords:
  - crystal structure
  - materials informatics
  - coordination environment
  - periodic dimensionality
  - motif network
  - knowledge graph
